{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "github-actions",
    "npm"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "automerge": true,
  "dependencyDashboard": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "webpack", "webpack-cli", "webpack-dev-server", "ts-loader", "typescript",
        "css-loader", "sass-loader", "sass", "style-loader", "karma-webpack",
        "@jsdevtools/coverage-istanbul-loader", "@types/mocha", "@types/chai",
        "mocha", "chai", "karma", "karma-chrome-launcher", "karma-coverage",
        "karma-mocha", "karma-mocha-reporter", "karma-sourcemap-loader"
      ],
      "groupName": "build and test toolchain",
      "separateMajorMinor": false
    }
  ]
}
